{
  "name": "stanczyk",
  "productName": "Stańczyk",
  "version": "1.2.0",
  "description": "Stańczyk — edytor animacji z kropek: halftone, piksele, ASCII, LED",
  "main": "desktop/main.js",
  "private": true,
  "author": "Fryderyk Głowacki",
  "license": "GPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "smoke": "STANCZYK_SMOKE=1 electron .",
    "build": "electron-builder --mac --arm64 --dir",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder --mac --win",
    "build:3d": "node scripts/build-3d.js"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "esbuild": "0.24.0",
    "three": "0.170.0"
  },
  "build": {
    "appId": "pl.bgs.stanczyk",
    "productName": "Stanczyk",
    "copyright": "Bilak Głowacki Samborska",
    "files": [
      "index.html",
      "material.js",
      "three3d.js",
      "i18n-en.js",
      "default-image.js",
      "desktop/**/*",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "CFBundleDisplayName": "Stańczyk",
        "LSHasLocalizedDisplayName": true
      }
    },
    "fileAssociations": [
      {
        "ext": "stanczyk",
        "name": "Projekt Stańczyka",
        "description": "Projekt Stańczyka",
        "role": "Editor",
        "icon": "build/icon"
      },
      {
        "ext": "kropkarnia",
        "name": "Projekt Stańczyka (starszy)",
        "description": "Projekt Stańczyka",
        "role": "Editor",
        "icon": "build/icon"
      }
    ],
    "afterPack": "scripts/after-pack.js",
    "artifactName": "Stanczyk-${version}-${os}-${arch}.${ext}",
    "dmg": {
      "title": "Stańczyk ${version}${arch}",
      "artifactName": "Stanczyk-${version}-mac-${arch}.${ext}",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stańczyk",
      "installerLanguages": [
        "pl_PL"
      ],
      "language": "1045",
      "artifactName": "Stanczyk-${version}-win-x64-setup.${ext}",
      "uninstallDisplayName": "Stańczyk"
    }
  }
}
