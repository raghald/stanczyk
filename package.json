{
  "name": "kropkarnia",
  "productName": "Kropkarnia",
  "version": "1.0.0",
  "description": "Edytor animacji z kropek: halftone, piksele, ASCII, LED",
  "main": "desktop/main.js",
  "private": true,
  "author": "Fryderyk Głowacki",
  "scripts": {
    "start": "electron .",
    "smoke": "KROPKARNIA_SMOKE=1 electron .",
    "build": "electron-builder --mac --arm64 --dir",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder --mac --win"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "pl.bgs.kropkarnia",
    "productName": "Kropkarnia",
    "copyright": "Bilak Głowacki Samborska",
    "files": [
      "index.html",
      "material.js",
      "desktop/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "fileAssociations": [
      {
        "ext": "kropkarnia",
        "name": "Projekt Kropkarni",
        "description": "Projekt Kropkarni",
        "role": "Editor",
        "icon": "build/icon"
      }
    ],
    "afterPack": "scripts/after-pack.js",
    "artifactName": "Kropkarnia-${version}-${os}-${arch}.${ext}",
    "dmg": {
      "title": "Kropkarnia ${version}",
      "artifactName": "Kropkarnia-${version}-mac-${arch}.${ext}",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kropkarnia",
      "installerLanguages": [
        "pl_PL"
      ],
      "language": "1045",
      "artifactName": "Kropkarnia-${version}-win-x64-setup.${ext}",
      "uninstallDisplayName": "Kropkarnia"
    }
  }
}
